{
  "name": "shop-sim-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.12.1"
  },
  "scripts": {
    "build": "nest build api && nest build worker",
    "start:api": "nest start api --watch --env-file .env",
    "start:api:prod": "node dist/apps/api/main.js",
    "start:worker": "nest start worker --watch --env-file .env",
    "start:worker:prod": "node dist/apps/worker/main.js"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@types/node": "26.6.5",
    "typescript": "6.0.3"
  }
}
