{
  "name": "shop-sim-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.12.1"
  },
  "scripts": {
    "build": "nest build api && nest build worker",
    "start:api": "nest start api --watch --env-file .env",
    "start:api:prod": "node dist/apps/api/main.js",
    "start:worker": "nest start worker --watch --env-file .env",
    "start:worker:prod": "node dist/apps/worker/main.js",
    "lint": "pnpm lint:code && pnpm lint:openapi",
    "lint:code": "oxlint --type-aware --deny-warnings apps/",
    "lint:openapi": "REDOCLY_SUPPRESS_UPDATE_NOTICE=true redocly lint openapi/openapi.yaml",
    "openapi:bundle": "REDOCLY_SUPPRESS_UPDATE_NOTICE=true redocly bundle openapi/openapi.yaml --output dist/openapi/openapi.yaml",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@redocly/cli": "2.71.1",
    "@types/node": "26.6.5",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
