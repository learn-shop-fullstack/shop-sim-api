# api HTTP 포트 (기본 3000)
PORT=3000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/shop_sim
# Better Auth 세션 서명 비밀값 (ADR 0015). 32바이트 이상 무작위 값: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-32-random-bytes

# 토스페이먼츠 테스트 모드 (ADR 0009, #5). 실제 값은 .env에만 넣는다
# 결제위젯 연동 키의 시크릿 키(test_gsk_로 시작). 승인 API의 Basic 인증에 쓴다
# 클라이언트 키(test_gck_)는 브라우저 위젯용이라 shop-sim-web에 둔다. 두 키는 같은 쌍이어야 한다
TOSS_SECRET_KEY=test_gsk_
